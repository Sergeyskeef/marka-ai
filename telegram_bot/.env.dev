# Telegram Bot Development Configuration
# Копируйте этот файл в .env для использования

# Токен бота (получите у @BotFather)
BOT_TOKEN=your_bot_token_here

# === РЕЖИМ РАЗРАБОТКИ ===
# true = все пользователи админы, увеличенные лимиты
# false = нормальный режим с проверками (для production)
BOT_DEV_MODE=true

# Админы (Telegram User ID)
# В DEV_MODE не используется, но нужно для production
ADMIN_USERS=

# API настройки
APP_HOST=http://app:8000
BOT_TIMEOUT=60

# Логирование
BOT_LOG_LEVEL=INFO
# Логировать все сообщения пользователей
LOG_USER_MESSAGES=false

# === ДЛЯ PRODUCTION ===
# Раскомментируйте и настройте для production:

# BOT_DEV_MODE=false
# ADMIN_USERS=123456789,987654321
# LOG_USER_MESSAGES=true
# BOT_LOG_LEVEL=WARNING