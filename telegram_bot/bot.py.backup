# Добавить описание task-команд в /help
async def help_cmd(update: Update, _: ContextTypes.DEFAULT_TYPE):
    """Команда /help - показывает справку по всем командам."""
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    
    # Логируем команду
    command_event = log_telegram_command(
        command="/help",
        chat_id=chat_id,
        user_id=user_id,
        metadata={"command_type": "help"}
    )
    
    try:
        start_time = time.time()
        
        # Отправляем справку
        await send_help_message(update, _)
        
        execution_time = time.time() - start_time
        
        # Логируем успешное выполнение
        command_monitoring.log_result(
            command_event,
            result="Help message sent successfully",
            success=True,
            execution_time=execution_time
        )
        
    except Exception as e:
        # Логируем ошибку
        command_monitoring.log_result(
            command_event,
            result=f"Error in help command: {str(e)}",
            success=False,
            execution_time=time.time() - start_time if 'start_time' in locals() else 0.0,
            error_message=str(e)
        )
        
        await update.message.reply_text("Произошла ошибка при отправке справки.")

BOT_TOKEN: Final[str | None] = os.getenv("BOT_TOKEN")
