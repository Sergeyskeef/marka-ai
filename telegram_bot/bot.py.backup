# Инициализация системы мониторинга команд
command_monitoring = CommandMonitoringSystem()

def log_telegram_command(command: str, chat_id: int, user_id: int = None, 
                        parameters: dict = None, metadata: dict = None) -> CommandEvent:
    """
    Логирование команды из Telegram-бота.
    
    Args:
        command: Команда или сообщение
        chat_id: ID чата
        user_id: ID пользователя
        parameters: Параметры команды
        metadata: Дополнительные метаданные
        
    Returns:
        Созданное событие команды
    """
    return command_monitoring.log_command(
        command=command,
        source="telegram_bot",
        user_id=str(user_id) if user_id else str(chat_id),
        parameters=parameters or {},
        metadata={
            "chat_id": chat_id,
            "platform": "telegram",
            **(metadata or {})
        }
    )

