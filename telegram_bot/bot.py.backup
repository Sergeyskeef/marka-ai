async def sandbox_report_cmd(update: Update, _: ContextTypes.DEFAULT_TYPE) -> None:
    """Показать отчёт о последних действиях в песочнице."""
    try:
        # Создаем пустые файлы логов, если их нет
        await _sandbox_exec("touch /sandbox/sandbox_experiments.log /sandbox/sandbox_diff_report.txt")
        
        # Читаем логи
        experiments = await _sandbox_exec("cat /sandbox/sandbox_experiments.log")
        diff_report = await _sandbox_exec("cat /sandbox/sandbox_diff_report.txt")
        
        # Формируем отчёт
        report = "🧪 *Sandbox Report*\n\n"
        
        report += "*Последние действия:*\n"
        if experiments:
            report += experiments
        else:
            report += "Нет последних действий\n"
            
        report += "\n*Diff-отчёт (первые 40 строк):*\n"
        if diff_report:
            report += diff_report[:1000] + "..." if len(diff_report) > 1000 else diff_report
        else:
            report += "Нет изменений\n"
            
        await update.message.reply_text(report)
    except Exception as e:
        logging.error("Ошибка при формировании отчёта: %s", e, exc_info=True)
        await update.message.reply_text("⚠️ Не удалось сформировать отчёт. Попробуйте позже.")


