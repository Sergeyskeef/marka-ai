async def memory_analyze(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Анализирует память бота."""
    try:
        # Проверяем наличие аргументов
        if not context.args:
            await update.message.reply_text(
                "Пожалуйста, укажите тип памяти для анализа.\n"
                "Доступные типы: short_term, long_term, working"
            )
            return

        memory_type = context.args[0].lower()  # Приводим к нижнему регистру
        if memory_type not in ["short_term", "long_term", "working"]:
            await update.message.reply_text(
                "Неверный тип памяти. Используйте: short_term, long_term или working"
            )
            return

        # Получаем анализ памяти
        try:
            analysis = await memory_analyze_logic(memory_type)
            if not analysis:
                await update.message.reply_text(f"Не удалось получить анализ для {memory_type}")
                return

            # Форматируем и отправляем результат
            response = f"📊 *Анализ памяти {memory_type}*\n\n"
            for key, value in analysis.items():
                if isinstance(value, (int, float)):
                    response += f"*{key}*: {value}\n"
                elif isinstance(value, dict):
                    response += f"*{key}*:\n"
                    for k, v in value.items():
                        response += f"  - {k}: {v}\n"
                else:
                    response += f"*{key}*: {value}\n"

            # Разбиваем на части если превышает лимит
            if len(response) > TG_MESSAGE_LIMIT:
                chunks = [response[i:i+TG_MESSAGE_LIMIT] for i in range(0, len(response), TG_MESSAGE_LIMIT)]
                for chunk in chunks:
                    await update.message.reply_text(chunk, parse_mode=constants.ParseMode.MARKDOWN)
            else:
                await update.message.reply_text(response, parse_mode=constants.ParseMode.MARKDOWN)

        except Exception as e:
            logging.error(f"Ошибка при анализе памяти {memory_type}: {e}")
            await update.message.reply_text(
                f"Произошла ошибка при анализе памяти {memory_type}. Попробуйте позже."
            )

    except Exception as e:
        logging.error(f"Ошибка в memory_analyze: {e}")
        await update.message.reply_text("Произошла ошибка при обработке команды. Попробуйте позже.")


async def self_analyze_cmd(update: Update, _: ContextTypes.DEFAULT_TYPE) -> None:
    """Команда /self_analyze - генерирует отчёт о состоянии системы"""
    try:
        analyzer = SelfAnalyzer()
        analysis = analyzer.get_analysis()

        # Разбиваем длинный отчёт на части по 4000 символов (лимит Telegram)
        chunks = [analysis[i : i + 4000] for i in range(0, len(analysis), 4000)]

        for i, chunk in enumerate(chunks):
            if i == 0:
                await update.message.reply_text(
                    f"📊 *Отчёт о состоянии системы*\n\n{chunk}",
                    parse_mode=constants.ParseMode.MARKDOWN,
                )
            else:
                await update.message.reply_text(
                    chunk, parse_mode=constants.ParseMode.MARKDOWN
                )
    except Exception as e:
        logging.error("Ошибка при генерации отчёта: %s", e, exc_info=True)
        await update.message.reply_text(
            f"⚠️ Ошибка при генерации отчёта: {str(e)}",
            parse_mode=constants.ParseMode.MARKDOWN,
        )


def escape_markdown(text: str) -> str:
    # Экранирует спецсимволы для Telegram MarkdownV2
    escape_chars = r"_ * [ ] ( ) ~ ` > # + - = | { } . !"
    for ch in escape_chars.split():
        text = text.replace(ch, "\\" + ch)
    return text


async def send_help_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Отправляет пользователю справку по всем доступным командам и триггерам."""
    lines = ["\U0001f916 *Доступные команды и триггеры:*\n"]
    for cmd in COMMANDS_REGISTRY:
        name = escape_markdown(cmd["name"])
        desc = escape_markdown(cmd["description"])
        triggers = ", ".join([escape_markdown(tr) for tr in cmd["triggers"]])
        lines.append(f"*{name}* — {desc}\n_Триггеры:_ {triggers}\n")
    text = "\n".join(lines)
    # Telegram лимит 4000 символов
    for i in range(0, len(text), 4000):
        await update.message.reply_markdown_v2(text[i : i + 4000])


async def parse_and_dispatch_command(
    text: str, update: Update, context: ContextTypes.DEFAULT_TYPE
) -> bool:
    """Парсинг и диспетчеризация команд"""
    
    # Проверяем shell-команды (начинаются с !)
    if text.startswith("!"):
        await sandbox_exec_cmd(update, context)
        return True
    
    # Проверяем команды из реестра
    for cmd in COMMANDS_REGISTRY:
        if text.lower() in [t.lower() for t in cmd["triggers"]]:
            if cmd["name"] == "/start":
                await start_cmd(update, context)
            elif cmd["name"] == "/sync":
                await sync_cmd(update, context)
            elif cmd["name"] == "/help":
                await help_cmd(update, context)
            elif cmd["name"] == "/status":
                await status_cmd(update, context)
            elif cmd["name"] == "/sandbox_report":
                await sandbox_report_cmd(update, context)
            elif cmd["name"] == "/selfcheck":
                await selfcheck_cmd(update, context)
            elif cmd["name"] == "/update_passport":
                await update_passport_cmd(update, context)
            elif cmd["name"] == "/memory_search":
                await memory_search(update, context)
            elif cmd["name"] == "/memory_save":
                await memory_save_cmd(update, context)
            elif cmd["name"] == "/memory_update":
                await memory_update_cmd(update, context)
            elif cmd["name"] == "/memory_delete":
                await memory_delete_cmd(update, context)
            elif cmd["name"] == "/memory_analyze":
                await memory_analyze(update, context)
            elif cmd["name"] == "/self_analyze":
                await self_analyze_cmd(update, context)
            elif cmd["name"] == "/analyze_self":
                await analyze_self_cmd(update, context)
            elif cmd["name"] == "/sandbox_experiment":
                await sandbox_experiment_cmd(update, context)
            elif cmd["name"] == "/task":
                await task_cmd(update, context)
            elif cmd["name"] == "/task_list":
                await task_list(update, context)
            elif cmd["name"] == "/task_status":
                await task_status(update, context)
            elif cmd["name"] == "/task_analyze":
                await task_analyze(update, context)
            elif cmd["name"] == "/task_create":
                await task_create(update, context)
            elif cmd["name"] == "/task_cancel":
                await task_cancel(update, context)
            elif cmd["name"] == "/self_improve":
                await self_improve_cmd(update, context)
            elif cmd["name"] == "/improve_history":
                await improve_history_cmd(update, context)
            elif cmd["name"] == "/accept_improvement":
                await accept_improvement_cmd(update, context)
            elif cmd["name"] == "/reject_improvement":
                await reject_improvement_cmd(update, context)
            elif cmd["name"] == "/sandbox_diff":
                await sandbox_diff_cmd(update, context)
            elif cmd["name"] == "/sandbox_apply":
                await sandbox_apply_cmd(update, context)
            elif cmd["name"] == "/sandbox_validate":
                await sandbox_validate_cmd(update, context)
            elif cmd["name"] == "/pytest":
                await pytest_cmd(update, context)
            elif cmd["name"] == "/approve":
                await approve_cmd(update, context)
            elif cmd["name"] == "/decompose":
                await decompose_cmd(update, context)
            else:
                # Если есть action в реестре, используем его
                if cmd.get("action"):
                    await cmd["action"](update, context)
                else:
                    # Логируем неизвестную команду
                    chat_id = update.effective_chat.id
                    user_id = update.effective_user.id
                    unknown_event = log_telegram_command(
                        command=f"UNKNOWN_COMMAND: {text}",
                        chat_id=chat_id,
                        user_id=user_id,
                        metadata={"command_type": "unknown"}
                    )
                    command_monitoring.log_result(
                        unknown_event,
                        result="Unknown command",
                        success=False,
                        error_message="Command not implemented"
                    )
                    await update.message.reply_text(f"❌ Неизвестная команда: {text}")
            return True
    return False


async def text_msg_fake(
    update: Update, context: ContextTypes.DEFAULT_TYPE, fake_text: str
):
    """Позволяет вызывать text_msg с подменённым текстом (для маппинга)."""

    class FakeMessage:

        def __init__(self, text):
            self.text = text

    fake_update = Update(update.update_id, message=FakeMessage(fake_text))
    await text_msg(fake_update, context)


async def text_msg(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обработка текстовых сообщений."""
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    text = update.message.text.strip()
    
    # Логируем сообщение пользователя
    command_event = log_telegram_command(
        command=text,
        chat_id=chat_id,
        user_id=user_id,
        metadata={"message_type": "user_text"}
    )
    
    try:
        # Проверяем, является ли это командой
        if await parse_and_dispatch_command(text, update, context):
            # Логируем успешное выполнение команды
            command_monitoring.log_result(
                command_event, 
                result="Command executed successfully",
                success=True,
                execution_time=0.0
            )
            return
        
        # Если это не команда, обрабатываем как вопрос к Марку
        start_time = time.time()
        
        # Логируем начало обработки вопроса
        question_event = log_telegram_command(
            command=f"QUESTION: {text}",
            chat_id=chat_id,
            user_id=user_id,
            metadata={"message_type": "question_to_mark"}
        )
        
        # Получаем ответ от Марка
        response = await _chat_ask(text, chat_id)
        
        execution_time = time.time() - start_time
        
        if response:
            # Логируем успешный ответ
            command_monitoring.log_result(
                question_event,
                result=f"Response generated: {response[:100]}...",
                success=True,
                execution_time=execution_time
            )
            
            # Отправляем ответ пользователю
            await update.message.reply_text(response)
        else:
            # Логируем ошибку
            command_monitoring.log_result(
                question_event,
                result="Failed to generate response",
                success=False,
                execution_time=execution_time,
                error_message="No response from chat API"
            )
            
            await update.message.reply_text(
                "Извините, не удалось получить ответ. Попробуйте позже."
            )
            
    except Exception as e:
        # Логируем ошибку обработки
        command_monitoring.log_result(
            command_event,
            result=f"Error processing message: {str(e)}",
            success=False,
            execution_time=time.time() - start_time if 'start_time' in locals() else 0.0,
            error_message=str(e)
        )
        
        await update.message.reply_text(
            "Произошла ошибка при обработке сообщения. Попробуйте позже."
        )


# Обработчик ошибок для бота


async def error_handler(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Обрабатывает ошибки, возникающие в обработчиках."""
    logging.error(
        "Ошибка при обработке сообщения: %s", context.error, exc_info=context.error
    )

    # Сообщаем пользователю об ошибке, если возможно
    if update and update.effective_message:
        await update.effective_message.reply_text(
            "⚠️ Произошла ошибка при обработке сообщения. Пожалуйста, попробуйте позже."
        )


# ────────── entrypoint ───────────────────────────────────────────────


async def task_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Обработчик команды /task."""
    if not context.args:
        await update.message.reply_text(
            "Использование:\n"
            "/task list [status] - список задач\n"
            "/task status <id> - статус задачи\n"
            "/task analyze <id> - анализ задачи\n"
            "/task create <type> <description> [priority] - создать задачу\n"
            "/task cancel <id> - отменить задачу"
        )
        return

    subcommand = context.args[0].lower()
    if subcommand == "list":
        await task_list(update, context)
    elif subcommand == "status":
        await task_status(update, context)
    elif subcommand == "analyze":
        await task_analyze(update, context)
    elif subcommand == "create":
        await task_create(update, context)
    elif subcommand == "cancel":
        await task_cancel(update, context)
    else:
        await update.message.reply_text(f"Неизвестная подкоманда: {subcommand}")


async def sandbox_exec_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Команда !<cmd> - выполнение shell-команды в песочнице."""
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    text = update.message.text.strip()
    
    # Извлекаем команду (убираем ! в начале)
    if text.startswith("!"):
        command = text[1:].strip()
    else:
        command = text
    
    # Логируем команду
    command_event = log_telegram_command(
        command=f"SANDBOX_EXEC: {command}",
        chat_id=chat_id,
        user_id=user_id,
        metadata={"command_type": "sandbox_exec", "shell_command": command}
    )
    
    try:
        start_time = time.time()
        
        # Выполняем команду в песочнице
        result = await _sandbox_exec(command)
        
        execution_time = time.time() - start_time
        
        # Отправляем результат
        await update.message.reply_markdown_v2(result)
        
        # Логируем успешное выполнение
        command_monitoring.log_result(
            command_event,
            result=f"Command executed: {result[:100]}...",
            success=True,
            execution_time=execution_time
        )
        
    except Exception as e:
        # Логируем ошибку
        command_monitoring.log_result(
            command_event,
            result=f"Error in sandbox_exec: {str(e)}",
            success=False,
            execution_time=time.time() - start_time if 'start_time' in locals() else 0.0,
            error_message=str(e)
        )
        
        await update.message.reply_text(f"❌ Ошибка выполнения команды: {str(e)}")


async def sandbox_diff_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Получение диффа песочницы"""
    task = task_executor.create_task(
        name="Get sandbox diff",
        description="Get changes in sandbox",
        priority=TaskPriority.MEDIUM,
        category=TaskCategory.SANDBOX
    )
    success, diff = task_executor.create_sandbox_diff(task.id)
    if success:
        if diff:
            await update.message.reply_text(f"📝 Изменения в песочнице:\n\n```\n{diff}\n```")
        else:
            await update.message.reply_text("ℹ️ Нет изменений в песочнице")
    else:
        await update.message.reply_text(f"❌ Ошибка получения изменений:\n\n{diff}")


async def sandbox_apply_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Применение изменений из песочницы"""
    task = task_executor.create_task(
        name="Apply sandbox changes",
        description="Apply changes from sandbox",
        priority=TaskPriority.MEDIUM,
        category=TaskCategory.SANDBOX
    )
    success, output = task_executor.apply_sandbox_changes(task.id)
    if success:
        await update.message.reply_text("✅ Изменения успешно применены")
    else:
        await update.message.reply_text(f"❌ Ошибка применения изменений:\n\n{output}")


async def sandbox_validate_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Валидация изменений в песочнице"""
    task = task_executor.create_task(
        name="Validate sandbox changes",
        description="Validate changes in sandbox",
        priority=TaskPriority.MEDIUM,
        category=TaskCategory.SANDBOX
    )
    success, output = task_executor.validate_sandbox_changes(task.id)
    if success:
        await update.message.reply_text("✅ Изменения прошли валидацию")
    else:
        await update.message.reply_text(f"❌ Ошибка валидации изменений:\n\n{output}")


async def improve_history_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Показывает историю всех предложений по улучшениям и их статусы."""
    suggestions = improvement_service.list_suggestions()
    if not suggestions:
        await update.message.reply_text("История предложений пуста.")
        return
    lines = []
    for s in suggestions:
        status_emoji = {
            "new": "🟢",
            "accepted": "🟡",
            "rejected": "🔴",
            "done": "✅"
        }.get(s.status, "❔")
        lines.append(f"{status_emoji} <b>{s.text}</b>\nID: <code>{s.id}</code>\nСтатус: <b>{s.status}</b>\nВремя: {s.timestamp}")
    await update.message.reply_text("История предложений:\n\n" + "\n\n".join(lines), parse_mode="HTML")


async def accept_improvement_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Принять предложение по улучшению (меняет статус на accepted и создаёт задачу)."""
    if not context.args:
        await update.message.reply_text("Укажите ID предложения для принятия: /accept_improvement <id>")
        return
    suggestion_id = context.args[0]
    suggestion = improvement_service.get_suggestion(suggestion_id)
    if not suggestion:
        await update.message.reply_text(f"❌ Предложение с ID {suggestion_id} не найдено.")
        return
    # Меняем статус
    improvement_service.update_status(suggestion_id, "accepted")
    # Автоматически создаём задачу через TaskExecutor
    task = task_executor.create_task(
        name=f"Улучшение: {suggestion.text[:40]}",
        description=suggestion.text,
        priority=TaskPriority.MEDIUM,
        category=TaskCategory.CUSTOM
    )
    # Сохраняем связь задачи с предложением
    suggestion.history.append(task.id)
    improvement_service._save()
    await update.message.reply_text(f"✅ Предложение {suggestion_id} принято (статус: accepted)\nАвтоматически создана задача с id: <code>{task.id}</code>", parse_mode="HTML")


async def reject_improvement_cmd(update: Update, context: ContextTypes.DEFAULT_TYPE) -> None:
    """Отклонить предложение по улучшению (меняет статус на rejected)."""
    if not context.args:
        await update.message.reply_text("Укажите ID предложения для отклонения: /reject_improvement <id>")
        return
    suggestion_id = context.args[0]
    success = improvement_service.update_status(suggestion_id, "rejected")
    if success:
        await update.message.reply_text(f"🔴 Предложение {suggestion_id} отклонено (статус: rejected)")
    else:
        await update.message.reply_text(f"❌ Предложение с ID {suggestion_id} не найдено.")


