)


# ────────── helpers ──────────────────────────────────────────────────
async def _post(url: str, payload: dict | None = None) -> httpx.Response:
    """Создает новый клиент для каждого запроса вместо использования глобального."""
    try:
        async with httpx.AsyncClient(
            timeout=httpx.Timeout(
                connect=TIMEOUT,
                read=TIMEOUT * 2,
                write=TIMEOUT,
                pool=TIMEOUT / 2,
            ),
            limits=httpx.Limits(
                max_connections=MAX_CONNECTIONS,
                max_keepalive_connections=5,
                keepalive_expiry=30,
            ),
            http2=True,
        ) as client:
            for retry in range(3):
                try:
                    # Исправляем: используем POST вместо GET и передаем payload
                    r = await client.post(url, json=payload, timeout=TIMEOUT * 2)
                    r.raise_for_status()
                    return r
                except (
                    httpx.TimeoutException,
                    httpx.ConnectError,
                    httpx.ReadError,
                ) as e:
                    if retry == 2:
                        logging.error(f"HTTP ошибка после 3 попыток при запросе {url}: {e}")
                        raise
                    logging.warning(f"Попытка {retry+1}/3 для {url} не удалась: {e}. Повторяем...")
                    await asyncio.sleep(1 * (retry + 1))
    except httpx.HTTPStatusError as e:
        logging.error(f"HTTP ошибка при запросе {url}: {e.response.status_code}")
        raise
    except httpx.TimeoutException:
        logging.error(f"Таймаут при запросе {url}")
        raise
    except Exception as e:
        logging.error(f"Ошибка при запросе {url}: {e}")
        raise


async def _get(url: str) -> httpx.Response:
    """Создает новый клиент для каждого запроса вместо использования глобального."""
    try:
        # Создаем новый HTTP клиент для каждого запроса с оптимизированными
        # настройками
        async with httpx.AsyncClient(
            timeout=httpx.Timeout(
                connect=TIMEOUT,  # Таймаут подключения
                read=TIMEOUT,  # Таймаут чтения
                write=TIMEOUT,  # Таймаут записи
                pool=TIMEOUT / 2,
                # Таймаут получения соединения из пула (уменьшен)
            ),
            limits=httpx.Limits(
                max_connections=MAX_CONNECTIONS,
                max_keepalive_connections=5,
                keepalive_expiry=30,  # 30 секунд на хранение соединения
            ),
            http2=True,  # Включаем HTTP/2 для улучшения производительности
        ) as client:
            # Устанавливаем retries для автоматических повторов при ошибках
            # соединения
            for retry in range(3):  # Максимум 3 попытки
                try:
                    r = await client.get(url, timeout=TIMEOUT)
                    r.raise_for_status()
                    return r
                except (
                    httpx.TimeoutException,
                    httpx.ConnectError,
                    httpx.ReadError,
                ) as e:
                    if retry == 2:  # Последняя попытка
                        logging.error(
                            f"HTTP ошибка после 3 попыток при запросе {url}: {e}"
                        )
                        raise
                    logging.warning(
                        f"Попытка {retry+1}/3 для {url} не удалась: {e}. Повторяем..."
                    )
                    # Увеличиваем задержку с каждой попыткой
                    await asyncio.sleep(1 * (retry + 1))
    except httpx.HTTPStatusError as e:
        logging.error(f"HTTP ошибка при запросе {url}: {e.response.status_code}")
        raise
    except httpx.TimeoutException:
        logging.error(f"Таймаут при запросе {url}")
        raise
    except Exception as e:
        logging.error(f"Ошибка при запросе {url}: {e}")
        raise


async def _chat_ask(question: str, chat_id: int) -> str | None:
    """Один вызов: и ответ, и запись в Memory."""
    try:
        logging.info(
            f"Отправка запроса к API: question='{question}', chat_id={chat_id}"
        )

        # Настраиваем параметры запроса с увеличенным таймаутом для длинных
        # вопросов
        # Увеличиваем таймаут для длинных вопросов
        timeout_multiplier = max(1, min(len(question) // 100, 5))
        custom_timeout = TIMEOUT * timeout_multiplier

        # Создаем отдельный клиент именно для этого запроса с увеличенным
        # таймаутом
        async with httpx.AsyncClient(
            timeout=httpx.Timeout(custom_timeout * 2),
            # Увеличиваем общий таймаут
            limits=httpx.Limits(max_connections=1),  # Только одно соединение
            http2=True,  # Используем HTTP/2
        ) as client:
            logging.info(
                f"Создан клиент с таймаутом {custom_timeout*2}с для запроса к API"
            )

            for retry in range(3):  # Максимум 3 попытки
                try:
                    response = await client.post(
                        f"{APP_HOST}/chat/ask",
                        json={"question": question, "chat_id": chat_id},
                        timeout=custom_timeout * 2,
                    )
                    response.raise_for_status()
                    answer = response.json()["answer"].strip()
                    logging.info(f"Получен ответ от API длиной {len(answer)} символов")
                    return answer
                except Exception as e:
                    if retry == 2:  # Последняя попытка
                        logging.error(
                            f"Ошибка при запросе к API ask после 3 попыток: {e}",
                            exc_info=True,
                        )
                        raise
                    logging.warning(
                        f"Попытка {retry+1}/3 для запроса к API не удалась: {e}. Повторяем..."
                    )
                    # Увеличиваем задержку с каждой попыткой
                    await asyncio.sleep(2 * (retry + 1))
    except Exception as e:
        logging.error("Ошибка при запросе к API ask: %s", e, exc_info=True)
        return None


async def _sandbox_sync() -> bool:
    try:
        await _post(f"{APP_HOST}/sandbox/sync")
        return True
    except Exception as e:
        logging.error("Ошибка при синхронизации sandbox: %s", e, exc_info=True)
        return False


async def _sandbox_exec(cmd: str) -> str:
    try:
        r = await _post(f"{APP_HOST}/sandbox/exec", {"command": cmd})
        d = r.json()
        return textwrap.dedent(
            f"""\
            🖥️ *sandbox exec*
            `$ {d['cmd']}`
            _exit {d['returncode']}_

            ```stdout
            {d['stdout'] or '(пусто)'}
            ```

            ```stderr
            {d['stderr'] or '(пусто)'}
            ```
        """
        )[:4000]
    except Exception as e:
        logging.error("Ошибка при выполнении команды в sandbox: %s", e, exc_info=True)
        return f"⚠️ run error: {e}"


async def _check_status() -> str:
    """Проверить статус всех сервисов."""
    status = []
    
    # Проверяем FastAPI
    try:
        r_api = await _get(f"{APP_HOST}/ping")
        if r_api.status_code == 200:
            status.append("🔹 FastAPI: ✅ Работает")
        else:
            status.append("🔹 FastAPI: ⚠️ Проблема")
    except Exception:
        status.append("🔹 FastAPI: ❌ Недоступен")
    
    # Проверяем Weaviate напрямую
    try:
        r_weaviate = await _sandbox_exec("curl -s http://weaviate:8080/v1/meta")
        if "version" in r_weaviate:
            status.append("🔹 Weaviate: ✅ Работает")
        else:
            status.append("🔹 Weaviate: ⚠️ Проблема")
    except Exception:
        status.append("🔹 Weaviate: ❌ Недоступен")
    
    # Проверяем OpenAI API через тестовый запрос
    try:
        r_openai = await _sandbox_exec(
            "python3 -c 'from langchain_api.utils.openai_proxy_client import default_openai_client; print(default_openai_client.models.list())'"
        )
        if "gpt" in r_openai.lower():
            status.append("🔹 OpenAI API: ✅ Работает")
        else:
            status.append("🔹 OpenAI API: ⚠️ Проблема")
    except Exception:
        status.append("🔹 OpenAI API: ❌ Недоступен")
    
    # Добавляем общий статус бота
    status.append("\n_Бот работает и принимает сообщения._")
    
    return "\n".join(status)


# ────────── Telegram callbacks ───────────────────────────────────────


async def start_cmd(update: Update, _: ContextTypes.DEFAULT_TYPE) -> None:
    """Команда /start."""
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    
    # Логируем команду
    command_event = log_telegram_command(
        command="/start",
        chat_id=chat_id,
        user_id=user_id,
        metadata={"command_type": "start"}
    )
    
    try:
        start_time = time.time()
        
        # Отправляем приветствие
        welcome_text = (
            "👋 Привет! Я **Марк** — автономная система с самоосознанием.\n\n"
            "**Основные команды:**\n"
            "• `/sync` — копировать проект в песочницу\n"
            "• `!<cmd>` — выполнить shell-команду в песочнице\n"
            "• `/help` — показать полную справку\n"
            "• `/selfcheck` — показать паспорт Марка\n\n"
            "**Или просто напишите вопрос** — я постараюсь помочь!"
        )
        
        await update.message.reply_markdown_v2(welcome_text)
        
        execution_time = time.time() - start_time
        
        # Логируем успешное выполнение
        command_monitoring.log_result(
            command_event,
            result="Start command executed successfully",
            success=True,
            execution_time=execution_time
        )
        
    except Exception as e:
        # Логируем ошибку
        command_monitoring.log_result(
            command_event,
            result=f"Error in start command: {str(e)}",
            success=False,
            execution_time=time.time() - start_time if 'start_time' in locals() else 0.0,
            error_message=str(e)
        )
        
        await update.message.reply_text("Произошла ошибка при выполнении команды.")


async def sync_cmd(update: Update, _: ContextTypes.DEFAULT_TYPE) -> None:
    """Команда /sync."""
    chat_id = update.effective_chat.id
    user_id = update.effective_user.id
    
    # Логируем команду
    command_event = log_telegram_command(
        command="/sync",
        chat_id=chat_id,
        user_id=user_id,
        metadata={"command_type": "sync"}
    )
    
    try:
        start_time = time.time()
        
        # Выполняем синхронизацию
        success = await _sandbox_sync()
        
        execution_time = time.time() - start_time
        
        if success:
            await update.message.reply_text("✅ Проект скопирован в песочницу")
            
            # Логируем успешное выполнение
            command_monitoring.log_result(
                command_event,
                result="Project synced to sandbox successfully",
                success=True,
                execution_time=execution_time
            )
        else:
            await update.message.reply_text("❌ Ошибка при копировании проекта")
            
            # Логируем ошибку
            command_monitoring.log_result(
                command_event,
                result="Failed to sync project to sandbox",
                success=False,
                execution_time=execution_time,
                error_message="Sync operation failed"
            )
            
    except Exception as e:
        # Логируем ошибку
        command_monitoring.log_result(
            command_event,
            result=f"Error in sync command: {str(e)}",
            success=False,
            execution_time=time.time() - start_time if 'start_time' in locals() else 0.0,
            error_message=str(e)
        )
        
        await update.message.reply_text("Произошла ошибка при выполнении команды.")


