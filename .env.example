# Mark AI Assistant - Environment Configuration
# Copy this file to .env and fill in your values

# ===== REQUIRED SETTINGS =====

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
# Model to use for chat completions (gpt-5-mini, gpt-4, etc.)
OPENAI_MODEL=gpt-5-mini
# Model for embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Temperature for generation (0.0-2.0, higher = more creative)
OPENAI_TEMPERATURE=0.7
# Max tokens for response (leave empty for model default)
OPENAI_MAX_TOKENS=

# Telegram Bot Configuration
BOT_TOKEN=your-telegram-bot-token-here
# Development mode (true = all users are admins)
BOT_DEV_MODE=true
# Admin user IDs (comma-separated Telegram user IDs)
ADMIN_USERS=123456789,987654321
# Log all user messages
LOG_USER_MESSAGES=true

# ===== SERVICE CONFIGURATION =====

# API Service
API_URL=http://app:8000
APP_NAME=Mark AI Assistant
APP_VERSION=2.0.0
DEBUG=false

# Neo4j Database
NEO4J_URI=bolt://graphiti-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
# Neo4j Auth (for container)
NEO4J_AUTH=neo4j/password

# Graphiti Memory Service
GRAPHITI_URL=http://graphiti:8001

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
# Redis password (optional, recommended for production)
REDIS_PASSWORD=your-redis-password-here
# Full Redis URL (auto-constructed if REDIS_PASSWORD is set)
REDIS_URL=redis://redis:6379

# ===== MEMORY SYSTEM SETTINGS =====

# Use direct Neo4j connection for memory operations
USE_DIRECT_NEO4J=true
# Also sync to Graphiti (for compatibility)
SYNC_TO_GRAPHITI=false

# ===== SECURITY & LIMITS =====

# Secret key for sessions (generate a random string)
SECRET_KEY=your-secret-key-here

# Rate limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Sandbox execution limits
SANDBOX_TIMEOUT=30
SANDBOX_MAX_OUTPUT_SIZE=1048576

# ===== OPTIONAL SETTINGS =====

# Environment (development, staging, production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Webhook URL for notifications (optional)
WEBHOOK_URL=

# Metrics
ENABLE_METRICS=true
METRICS_PORT=8001

# ===== ADVANCED SETTINGS =====

# Memory settings
MEMORY_SEARCH_LIMIT=20
MEMORY_SIMILARITY_THRESHOLD=0.7

# Agent settings
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT=300

# Prompts
USE_DYNAMIC_PROMPTS=true
PROMPT_CACHE_TTL=3600

# ===== DOCKER COMPOSE SPECIFIC =====

# Resource limits (used by docker-compose)
COMPOSE_PROJECT_NAME=marka
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1
