# Mark AI Assistant Environment Configuration
# Copy this file to .env and fill in your values

# === OpenAI Configuration ===
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=4096  # Optional, uncomment to limit

# === Memory System ===
USE_DIRECT_NEO4J=true
SYNC_TO_GRAPHITI=false

# === Neo4j Database ===
NEO4J_URI=bolt://graphiti-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# === Graphiti Service ===
GRAPHITI_URL=http://graphiti:8001

# === Redis Cache ===
REDIS_URL=redis://redis:6379

# === Telegram Bot (Optional) ===
TELEGRAM_BOT_TOKEN=

# === Learning System ===
REAP_CYCLE_AUTO_RUN=false
REAP_CYCLE_INTERVAL=300  # seconds

# === Vector Search ===
VECTOR_DIMENSIONS=1536
VECTOR_SIMILARITY_THRESHOLD=0.7

# === Archival ===
ARCHIVE_DAYS_THRESHOLD=90

# === Performance ===
MAX_CONCURRENT_TOOLS=5
TOOL_TIMEOUT=30  # seconds

# === Prompt Management System ===
PROMPTS_STORAGE_PATH=/workspace/data/prompts
PROMPTS_CACHE_TTL=3600  # 1 hour
PROMPTS_MAX_CONTEXT_TOKENS=8192
PROMPTS_EVOLUTION_ENABLED=true
PROMPTS_EVOLUTION_CHECK_INTERVAL=60  # seconds
PROMPTS_ROUTER_ALPHA=0.25  # exploration parameter
PROMPTS_DEFAULT_ENVIRONMENT=development

# === Application Settings ===
APP_NAME=Mark AI Assistant
APP_VERSION=2.0.0
DEBUG=false
