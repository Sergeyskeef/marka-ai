# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
BOT_DEV_MODE=true  # Set to false for production
ADMIN_USERS=123456789,987654321  # Comma-separated Telegram user IDs

# Neo4j Configuration
NEO4J_URI=bolt://graphiti-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_password_here

# Application Settings
ENV=dev  # dev or prod
APP_HOST=http://app:8000
LOG_LEVEL=INFO

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Proxy Settings (optional)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port
# NO_PROXY=localhost,127.0.0.1,neo4j,redis

# Feature Flags
USE_DIRECT_NEO4J=true
USE_LEARNING_SYSTEM=true
USE_ENHANCED_CHAT=true

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
