[Unit]
Description=Mark host file reader with no command execution
After=local-fs.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/marka-host-reader/host_reader.py
User=root
Group=root
UMask=0027
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/marka-host-reader
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
MemoryMax=192M
CPUQuota=20%
TasksMax=8

[Install]
WantedBy=multi-user.target
